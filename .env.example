# Скопируйте в .env.local для локальной разработки с `vercel dev`
# На Vercel задайте те же переменные в Settings → Environment Variables

# Секрет синхронизации (один и тот же на сервере и в клиенте)
CRM_SYNC_SECRET=замените-на-длинную-случайную-строку
VITE_CRM_SYNC_SECRET=замените-на-длинную-случайную-строку

# Токен для вебхука dmp.one / лидогенерации (если не задан — используется CRM_SYNC_SECRET)
# URL: https://ваш-домен.vercel.app/api/leads/incoming?token=ЭТОТ_ТОКЕН
CRM_LEAD_WEBHOOK_TOKEN=замените-на-токен-для-dmp

# Postgres подставляется автоматически после создания Vercel Postgres / Neon:
# POSTGRES_URL=...

# Базовый URL API воркеров (страница /workers). Пока не задан — демо-данные.
# Ожидаемые эндпойнты:
#   GET {VITE_WORKERS_API_URL}/workers
#   GET {VITE_WORKERS_API_URL}/workers/:id/stats?period=today|yesterday|3days|week|month
# VITE_WORKERS_API_URL=https://your-workers-api.example.com
